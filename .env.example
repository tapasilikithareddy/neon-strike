# NEON STRIKE — Environment Configuration
# When deployed as a unified Node.js service (Render, Railway, Fly.io, etc.),
# the frontend automatically communicates with the Express/Socket.IO backend on the SAME origin.
# Zero environment variables are required for production!

# Port and Host (configured automatically by Render / hosting platforms):
# PORT=3001
# HOST=0.0.0.0

# Optional: Set only if frontend is deployed separately from backend (e.g. static Netlify frontend):
# VITE_WS_SERVER_URL=https://your-backend.onrender.com

# Optional: Multiplayer transport mode ('socket' or 'webrtc'). Defaults to 'socket'.
# VITE_MULTIPLAYER_TRANSPORT=socket

